generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  role      String   @default("farmer")
  name      String
  phone     String   @unique
  password  String
  document  String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}