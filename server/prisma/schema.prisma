generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  role      String   @default("farmer")
  name      String
  phone     String   @unique
  password  String
  document  String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Booking {
  id          String   @id @default(uuid())
  farmerId    String
  farmerName  String?
  crop        String
  quantity    Float
  mandiId     String?
  mandiName   String?
  timeSlot    String?
  status      String   @default("BOOKED") // Transitions: BOOKED -> WAITING -> VERIFIED -> PAID
  createdAt   DateTime @default(now())
}