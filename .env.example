# Backend API & Socket.io Service URL (Leave blank for local dev; set to Render URL in production)
VITE_BACKEND_URL=https://your-backend-service.onrender.com

# OpenWeather API Configuration (https://openweathermap.org/api)
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
NEXT_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Firebase Web App Configuration (https://console.firebase.google.com/)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# -------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (For Render Web Service Dashboard)
# -------------------------------------------------------------
# PORT=5001 (Render automatically injects PORT)
# NODE_ENV=production
